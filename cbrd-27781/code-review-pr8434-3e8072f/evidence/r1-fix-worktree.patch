diff --git a/src/query/vacuum.c b/src/query/vacuum.c
index 2ba71c6ae..98a9d73b8 100644
--- a/src/query/vacuum.c
+++ b/src/query/vacuum.c
@@ -3643,8 +3643,14 @@ vacuum_process_log_block (THREAD_ENTRY * thread_p, VACUUM_DATA_ENTRY * data, boo
 	}
 
 #if !defined (NDEBUG)
-      if (MVCC_ID_FOLLOW_OR_EQUAL (mvccid, threshold_mvccid) || MVCC_ID_PRECEDES (mvccid, data->oldest_visible_mvccid)
-	  || MVCC_ID_PRECEDES (data->newest_mvccid, mvccid))
+      /* RVOOS_NOTIFY_VACUUM carries the MVCCID of an UPDATE that committed before the postpone logged it, so it may
+       * precede the block's oldest visible MVCCID. That does not shorten the life of a dropped-file entry the
+       * notify needs: the UPDATE keeps its class lock until its postpones are done, so a drop of the heap is logged
+       * after the notify, and its dropped-file MVCCID (mvcc_next_id at the drop) is not older than the oldest
+       * visible MVCCID of the block that holds the notify. */
+      if (MVCC_ID_FOLLOW_OR_EQUAL (mvccid, threshold_mvccid)
+	  || (MVCC_ID_PRECEDES (mvccid, data->oldest_visible_mvccid)
+	      && log_record_data.rcvindex != RVOOS_NOTIFY_VACUUM) || MVCC_ID_PRECEDES (data->newest_mvccid, mvccid))
 	{
 	  /* threshold_mvccid or mvccid or block data may be invalid */
 	  assert (0);
@@ -5916,8 +5922,11 @@ vacuum_recover_lost_block_data (THREAD_ENTRY * thread_p)
 	      logpb_fatal_error (thread_p, true, ARG_FILE_LINE, "vacuum_recover_lost_block_data");
 	      return error_code;
 	    }
-	  /* Update oldest/newest MVCCID. */
-	  if (data.oldest_visible_mvccid == MVCCID_NULL || MVCC_ID_PRECEDES (mvccid, data.oldest_visible_mvccid))
+	  /* Update oldest/newest MVCCID. A notify's MVCCID may precede the block's oldest visible MVCCID at run time
+	   * (see vacuum_process_log_block); it lowers the oldest only when nothing else set it. */
+	  if (data.oldest_visible_mvccid == MVCCID_NULL
+	      || (MVCC_ID_PRECEDES (mvccid, data.oldest_visible_mvccid)
+		  && dummy_log_data.rcvindex != RVOOS_NOTIFY_VACUUM))
 	    {
 	      data.oldest_visible_mvccid = mvccid;
 	    }
diff --git a/src/transaction/log_append.cpp b/src/transaction/log_append.cpp
index 41cf9b246..ad23d98cb 100644
--- a/src/transaction/log_append.cpp
+++ b/src/transaction/log_append.cpp
@@ -1371,12 +1371,9 @@ prior_update_header_mvcc_info (const LOG_LSA &record_lsa, MVCCID mvccid, bool is
 	  log_Gl.hdr.newest_block_mvccid = mvccid;
 	}
     }
-  /* Keep the block's oldest at or below every MVCCID it holds, as vacuum_recover_lost_block_data does when it
-   * rebuilds a block. */
-  if (is_explicit_mvccid && mvccid < log_Gl.hdr.oldest_visible_mvccid)
-    {
-      log_Gl.hdr.oldest_visible_mvccid = mvccid;
-    }
+  /* An explicit MVCCID (RVOOS_NOTIFY_VACUUM) belongs to a transaction that already left the MVCC table, so it may
+   * precede the block's oldest visible MVCCID. The block's oldest is not lowered to it: entries must keep a
+   * non-decreasing oldest visible MVCCID, and the notify does not need it (see vacuum_process_log_block). */
   log_Gl.hdr.mvcc_op_log_lsa = record_lsa;
   log_Gl.hdr.does_block_need_vacuum = true;
 }
diff --git a/unit_tests/oos/test_oos_real_vacuum_server.cpp b/unit_tests/oos/test_oos_real_vacuum_server.cpp
index 18e3a1f80..721e377a3 100644
--- a/unit_tests/oos/test_oos_real_vacuum_server.cpp
+++ b/unit_tests/oos/test_oos_real_vacuum_server.cpp
@@ -538,6 +538,59 @@ TEST_F (OosRealVacuum, UpdateStaleVersionDrainsNewSurvives)
   recdes_free_data_area (&survivor);
 }
 
+// ============================================================================
+// TC-R3b: A notification whose MVCCID is older than its block's oldest visible MVCCID
+//
+// The commit postpone logs RVOOS_NOTIFY_VACUUM after logtb_complete_mvcc, so the global
+// oldest visible MVCCID may already have passed the UPDATE's MVCCID when the record lands in a
+// block. The notification must not lower that block's oldest visible MVCCID below the one of an
+// earlier block (vacuum keeps them non-decreasing), and vacuum must still reclaim the chains.
+// ============================================================================
+TEST_F (OosRealVacuum, NotifyOlderThanBlockOldestKeepsBlockOrderAndDrains)
+{
+  /* A committed transaction with MVCCID m0 that leaves a chain no row references. */
+  RECDES oos_rec {};
+  ASSERT_EQ (test_oos_utils::from_string_into_recdes (test_oos_utils::make_repeated_pattern_string (4096), oos_rec),
+	     NO_ERROR);
+  test_oos_utils::auto_freed_recdes_ptr defer_oos (&oos_rec, recdes_free_data_area);
+  OID oos_oid = OID_INITIALIZER;
+  ASSERT_EQ (test_oos_utils::oos_insert_from_recdes (thread_p, oos_vfid, oos_rec, oos_oid), NO_ERROR);
+  const MVCCID m0 = logtb_get_current_mvccid (thread_p);
+  ASSERT_TRUE (MVCCID_IS_VALID (m0));
+  commit_current_tran ();
+
+  LOG_LSA stamp = NULL_LSA;
+  ASSERT_EQ (oos_get_identity_stamp (thread_p, oos_oid, &stamp), NO_ERROR);
+
+  /* Let the vacuum master move the global oldest visible MVCCID past m0, then fill whole blocks whose
+   * oldest visible MVCCID is above m0. */
+  ASSERT_TRUE (wait_for_vacuum ([m0] { return log_Gl.mvcc_table.get_global_oldest_visible () > m0; }, 30));
+  close_log_block_containing (hfid, class_oid, scan_cache, current_log_blockid ());
+
+  /* Another transaction opens the next block, then the notification arrives with m0. */
+  RECDES filler {};
+  ASSERT_EQ (build_plain_heap_recdes (4096, filler), NO_ERROR);
+  test_oos_utils::auto_freed_recdes_ptr defer_filler (&filler, recdes_free_data_area);
+  OID filler_oid = OID_INITIALIZER;
+  ASSERT_EQ (heap_insert_mvcc (hfid, class_oid, scan_cache, filler, filler_oid), NO_ERROR);
+  const MVCCID block_oldest = log_Gl.hdr.oldest_visible_mvccid;
+  ASSERT_GT (block_oldest, m0);
+
+  std::vector<char> payload = oos_test_make_reclaim_intent_payload (oos_vfid, { oos_chain_ref { oos_oid, stamp } });
+  LOG_DATA_ADDR addr (&hfid.vfid, NULL, -1);
+  log_append_mvcc_undo_data_with_mvccid (thread_p, RVOOS_NOTIFY_VACUUM, &addr, (int) payload.size (),
+					 payload.data (), m0);
+  EXPECT_EQ (log_Gl.hdr.oldest_visible_mvccid, block_oldest)
+      << "the notification lowered its block's oldest visible MVCCID";
+  VACUUM_LOG_BLOCKID notify_block = current_log_blockid ();
+  commit_current_tran ();
+
+  close_log_block_containing (hfid, class_oid, scan_cache, notify_block);
+
+  ASSERT_TRUE (wait_for_vacuum ([this, oos_oid] { return oos_unreadable (oos_oid); }, 60))
+      << "vacuum did not reclaim the chain of the notification";
+}
