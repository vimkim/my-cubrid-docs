 static int
 build_heap_recdes_with_oos (const std::vector<OID> &oos_oids,
 			    const std::vector<INT64> &oos_lengths,
-			    RECDES &rec_out)
+			    RECDES &rec_out, int pad_bytes = 0)
 {
   const int n_oos = (int) oos_oids.size ();
   assert (n_oos > 0);
@@ -108,13 +108,15 @@ build_heap_recdes_with_oos (const std::vector<OID> &oos_oids,
   const int n_var = repr->n_variable;
   const int repr_id = repr->id;
   heap_classrepr_free_and_init (repr, &cache_index);
-  if (n_var < n_oos)
+  /* VOT offsets carry flags in their low two bits, so the padding keeps them aligned. */
+  if (n_var < n_oos || (pad_bytes > 0 && n_var == n_oos) || pad_bytes % VOT_ENTRY_SZ != 0)
     {
       return ER_FAILED;
     }
 
   const int vot_bytes = (n_var + 1) * VOT_ENTRY_SZ;	/* one entry per attribute plus the terminator */
