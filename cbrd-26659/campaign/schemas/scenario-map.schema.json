{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cubrid.example/cbrd-26659/scenario-map.schema.json",
  "title": "CBRD-26659 section 6 scenario traceability map",
  "description": "Maps every scenario of the normative context's section 6 (Test Scenarios) to requirement IDs or to an explicit, reasoned exclusion. Section 6 is a mandatory traceability input, not the coverage ceiling.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "scenarios"],
  "properties": {
    "schema_version": {"const": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "section", "revision", "content_hash"],
      "properties": {
        "document": {"const": "OOS-CONTEXT.md"},
        "section": {"type": "string"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario", "title", "requirements", "exclusion", "note"],
        "properties": {
          "scenario": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
          "title": {"type": "string", "minLength": 1},
          "requirements": {"type": "array", "items": {"type": "string", "pattern": "^OOS-(REP|SQL|RD|SCH|CL|DUR|OPS|RES)-[0-9]{2}$"}, "uniqueItems": true},
          "exclusion": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["reason"],
            "properties": {"reason": {"type": "string", "minLength": 1}}
          },
          "note": {"type": ["string", "null"], "description": "Where the scenario's own wording is superseded or partly UNSUPPORTED at the pin."}
        }
      }
    }
  }
}
