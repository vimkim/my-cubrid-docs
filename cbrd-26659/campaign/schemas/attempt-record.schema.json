{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cubrid.example/cbrd-26659/attempt-record.schema.json",
  "title": "CBRD-26659 attempt record (compact, one per attempt)",
  "description": "The compact record kept for every attempt, original or derived, forever. It carries identity, outcome, evidence status, ownership, deadlines and cleanup, and points at the bulky replay bundle. Original attempts, reruns, minimized derivatives and reproduction runs are linked through parent_attempt and finding_id; none replaces another.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "attempt_id", "kind", "parent_attempt", "finding_id", "case", "requirements", "manifest_id", "configuration", "started_at", "ended_at", "deadline", "outcome", "skip_reason", "assertions", "expected_versus_actual", "oos_evidence", "barriers", "injections", "resources_owned", "cleanup", "bundle", "reproduction", "notes"],
  "properties": {
    "schema_version": {"const": 1},
    "attempt_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"},
    "kind": {"enum": ["original", "rerun", "minimized", "reproduction"], "description": "original: first attempt of a scenario in an invocation. rerun: same workload again. minimized: reduced derivative that must keep both the failure and the OOS path. reproduction: fresh-fixture run counted toward a deterministic claim."},
    "parent_attempt": {"type": ["string", "null"], "description": "Required for rerun, minimized and reproduction attempts."},
    "finding_id": {"type": ["string", "null"], "description": "Groups attempts of one scenario/finding across invocations."},
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "path", "name"],
      "properties": {
        "repository": {"enum": ["testcases", "testcases-private-ex"]},
        "path": {"type": "string"},
        "name": {"type": "string"}
      }
    },
    "requirements": {"type": "array", "items": {"type": "string", "pattern": "^OOS-(REP|SQL|RD|SCH|CL|DUR|OPS|RES)-[0-9]{2}$"}, "minItems": 1, "uniqueItems": true},
    "manifest_id": {"type": "string"},
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_size", "build_mode", "run_mode", "instrumentation_id", "seed"],
      "properties": {
        "page_size": {"enum": [4096, 8192, 16384]},
        "build_mode": {"enum": ["release", "debug"]},
        "run_mode": {"enum": ["standalone", "client-server"]},
        "instrumentation_id": {"type": ["string", "null"]},
        "seed": {"type": ["integer", "string", "null"]}
      }
    },
    "started_at": {"$ref": "#/$defs/timestamp"},
    "ended_at": {"$ref": "#/$defs/timestamp"},
    "deadline": {
      "type": "object",
      "description": "Every barrier and recovery wait has a deadline; a timeout captures evidence and never reports success.",
      "additionalProperties": false,
      "required": ["seconds", "reached", "evidence_captured_on_timeout"],
      "properties": {
        "seconds": {"type": "integer", "minimum": 1},
        "reached": {"type": "boolean"},
        "evidence_captured_on_timeout": {"type": ["boolean", "null"], "description": "Null when the deadline was not reached."}
      }
    },
    "outcome": {"$ref": "#/$defs/outcome"},
    "skip_reason": {"type": ["string", "null"]},
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executed", "failed"],
      "properties": {
        "executed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0}
      }
    },
    "expected_versus_actual": {"type": ["string", "null"], "description": "Path of the expected-versus-actual comparison (CTP result/answer diff or shell assertion log)."},
    "oos_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "channel", "reference", "applicability"],
      "properties": {
        "status": {"$ref": "#/$defs/evidence_status"},
        "channel": {"enum": [null, "show-heap-oos", "diagdb-owner-descriptor", "debug-oos-log", "instrumentation-counter", "injection-acknowledgement", "unit-test-seam", "other"]},
        "reference": {"type": ["string", "null"]},
        "applicability": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["fixture", "execution_path", "engine_configuration", "conditions", "source_manifest"],
          "properties": {
            "fixture": {"type": "string"},
            "execution_path": {"type": "string"},
            "engine_configuration": {"type": "string"},
            "conditions": {"type": "string"},
            "source_manifest": {"type": "string"}
          }
        }
      }
    },
    "barriers": {
      "type": "array",
      "description": "Acknowledged phases in schedule order; an unreached target phase never satisfies a schedule.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "participant", "acknowledged", "at"],
        "properties": {
          "name": {"type": "string"},
          "participant": {"type": "string"},
          "acknowledged": {"type": "boolean"},
          "at": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]}
        }
      }
    },
    "injections": {
      "type": "array",
      "description": "One entry per armed fault; an unfired hook provides no coverage.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["site", "target_operation", "occurrence_count", "requested_action", "fired", "acknowledgement"],
        "properties": {
          "site": {"type": "string"},
          "target_operation": {"type": "string"},
          "occurrence_count": {"type": "integer", "minimum": 0},
          "requested_action": {"type": "string"},
          "fired": {"type": "boolean"},
          "acknowledgement": {"type": ["string", "null"], "description": "Path of the fired-site acknowledgement evidence."}
        }
      }
    },
    "resources_owned": {
      "type": "object",
      "description": "Only these may be crashed or cleaned by the attempt.",
      "additionalProperties": false,
      "required": ["databases", "processes", "ports", "directories"],
      "properties": {
        "databases": {"type": "array", "items": {"type": "string"}},
        "processes": {"type": "array", "items": {"type": "string"}},
        "ports": {"type": "array", "items": {"type": "integer"}},
        "directories": {"type": "array", "items": {"type": "string", "pattern": "^/home/"}}
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["performed", "scope_verified", "evidence_preserved_first", "evidence"],
      "properties": {
        "performed": {"type": "boolean"},
        "scope_verified": {"type": "boolean", "description": "True when cleanup was checked to touch only resources_owned."},
        "evidence_preserved_first": {"type": ["boolean", "null"]},
        "evidence": {"type": ["string", "null"]}
      }
    },
    "bundle": {
      "type": ["object", "null"],
      "description": "Null only for a PASS whose bulky artifacts expired; the attempt record itself is kept.",
      "additionalProperties": false,
      "required": ["path", "hash"],
      "properties": {"path": {"type": "string"}, "hash": {"$ref": "#/$defs/sha256"}}
    },
    "reproduction": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["fresh_fixture", "consecutive_reproductions_so_far", "failure_reproduced"],
      "properties": {
        "fresh_fixture": {"type": "boolean"},
        "consecutive_reproductions_so_far": {"type": "integer", "minimum": 0},
        "failure_reproduced": {"type": "boolean"}
      }
    },
    "notes": {"type": ["string", "null"]}
  },
  "allOf": [
    {"if": {"properties": {"outcome": {"const": "SKIP"}}}, "then": {"properties": {"skip_reason": {"type": "string", "minLength": 1}}}},
    {"if": {"properties": {"kind": {"enum": ["rerun", "minimized", "reproduction"]}}}, "then": {"properties": {"parent_attempt": {"type": "string", "minLength": 1}}}},
    {"if": {"properties": {"deadline": {"properties": {"reached": {"const": true}}, "required": ["reached"]}}}, "then": {"properties": {"outcome": {"enum": ["FAIL", "BLOCKED"]}, "deadline": {"properties": {"evidence_captured_on_timeout": {"type": "boolean"}}}}}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"},
    "outcome": {"enum": ["PASS", "FAIL", "SKIP", "UNSUPPORTED", "BLOCKED"], "description": "Fixed per-attempt taxonomy."},
    "evidence_status": {"enum": ["proven", "reused", "missing", "not-applicable"]}
  }
}
