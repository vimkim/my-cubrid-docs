+/*
+ * fi_site_fire_and_acknowledge - count a reach of a deterministic site, decide whether this reach fires and,
+ *   when it does, write the acknowledgement to the server error log (CBRD-26659 campaign).
+ *
+ * return: true when the site must act, false when it must behave normally
+ *
+ *   arg(in): the site's FI_SITE_DESC
+ *   caller_file(in), caller_line(in): the site
+ *
+ * Note: The acknowledgement is a notification, not an error of the calling thread; the error state is cleared
+ *       afterwards and the site sets whatever error its action requires. With fault_injection_fire_at_occurrence
+ *       = 0 every reach fires; with k > 0 only the k-th reach since the server started fires (one-shot).
+ */
+static bool
+fi_site_fire_and_acknowledge (void *arg, const char *caller_file, const int caller_line)
+{
+  FI_SITE_DESC *desc = (FI_SITE_DESC *) arg;
+  char msg[512];
+  int reach, fired, fire_at;
+
+  if (desc == NULL)
+    {
+      assert (desc != NULL);
+      return false;
+    }
+
+  reach = ATOMIC_INC_32 (&desc->reach_count, 1);
+  fire_at = prm_get_integer_value (PRM_ID_FAULT_INJECTION_FIRE_AT_OCCURRENCE);
+  if (fire_at > 0 && reach != fire_at)
+    {
+      return false;
+    }
+
+  fired = ATOMIC_INC_32 (&desc->fired_count, 1);
+  snprintf (msg, sizeof (msg),
+	    "FAULT INJECTION ACK site=%s code=%d target_operation=\"%s\" requested_action=\"%s\" reach=%d fired=%d "
+	    "fire_at=%d", desc->site, (int) desc->code, desc->target_operation, desc->requested_action, reach, fired,
+	    fire_at);
+  er_set (ER_NOTIFICATION_SEVERITY, caller_file, caller_line, ER_FAILED_ASSERTION, 1, msg);
+  er_clear ();
+
+  return true;
+}
+
+/*
+ * fi_handler_ack_fail - acknowledge and tell the site to fail (the site chooses how: error return, throw, skip)
+ *
+ * return: ER_FAILED when the site must act, NO_ERROR otherwise
+ */
+static int
+fi_handler_ack_fail (THREAD_ENTRY * thread_p, void *arg, const char *caller_file, const int caller_line)
+{
+  if (fi_site_fire_and_acknowledge (arg, caller_file, caller_line))
+    {
+      return ER_FAILED;
+    }
+
+  return NO_ERROR;
+}
+
+/*
+ * fi_handler_ack_crash - acknowledge and terminate the process at once, like fi_handler_random_exit but
+ *   deterministically; fault_injection_action_prefer_abort_to_exit selects abort () or _exit ().
+ *
+ * return: NO_ERROR when the site does not fire (it never returns when it fires)
+ */
+static int
+fi_handler_ack_crash (THREAD_ENTRY * thread_p, void *arg, const char *caller_file, const int caller_line)
+{
+  if (fi_site_fire_and_acknowledge (arg, caller_file, caller_line))
+    {
+      if (prm_get_bool_value (PRM_ID_FAULT_INJECTION_ACTION_PREFER_ABORT_TO_EXIT))
+	{
+	  abort ();
+	}
+      else
+	{
+	  _exit (0);
+	}
+    }
+
+  return NO_ERROR;
+}
 #endif
