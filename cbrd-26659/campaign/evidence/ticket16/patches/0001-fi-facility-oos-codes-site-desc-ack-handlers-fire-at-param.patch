   FI_TEST_DBLINK_2PC_CRASH_BETWEEN_6_7 = 600004,	/* after (6) send decision, before (7) DELETE row */
 
+  /* OOS -- CBRD-26659 adversarial testcase campaign (700000 ~ 700099)
+   * Deterministic sites. Each passes an FI_SITE_DESC as the FI_TEST_ARG argument; the acknowledging handler
+   * (fi_handler_ack_fail, fi_handler_ack_crash) writes a "FAULT INJECTION ACK" line to the server error log
+   * when it fires. fault_injection_fire_at_occurrence selects the reach at which an armed site fires.
