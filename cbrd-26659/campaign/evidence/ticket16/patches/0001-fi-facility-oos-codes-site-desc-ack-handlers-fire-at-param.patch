+  FI_TEST_OOS_PUBLISH_OID_BAD_ALLOC = 700000,	/* allocation: OOS OID publication during insert */
+  FI_TEST_OOS_READ_GROUPED_BAD_ALLOC = 700001,	/* allocation: grouped Resolve prefetch during read */
+  FI_TEST_OOS_DELETE_HINT_BAD_ALLOC = 700002,	/* allocation: reclaim hint list during chain delete */
+  FI_TEST_OOS_PAGE_WRITE_FAIL = 700003,	/* data I/O: disk write of a PAGE_OOS page fails */
+  FI_TEST_OOS_LOG_WRITE_FAIL = 700004,	/* log I/O: disk write of an active log page fails */
+  FI_TEST_OOS_INSERT_MANY_FAIL = 700005,	/* interruption: oos_insert_many fails between publications */
+  FI_TEST_OOS_CRASH_BETWEEN_CHUNKS = 700006,	/* interruption: crash between the chunk inserts of one chain */
+  FI_TEST_OOS_CRASH_BEFORE_HEAP_PUBLICATION = 700007,	/* interruption: crash after the chunks, before the heap insert */
+  FI_TEST_OOS_RV_UNDO_INSERT_FAIL = 700008,	/* rollback: undo of RVOOS_INSERT fails at run time */
+  FI_TEST_OOS_VACUUM_DELETE_FAIL = 700009,	/* vacuum: forward-walk delete of a value chain fails */
+  FI_TEST_OOS_RECLAIM_WRITE_FIX_SKIP = 700010,	/* reclamation: write fix of a reclaim candidate is skipped */
+  FI_TEST_OOS_RV_REDO_INSERT_FAIL = 700011,	/* recovery: redo of RVOOS_INSERT fails during restart */
+
   /* etc .... */
 
 } FI_TEST_CODE;
@@ -104,6 +122,24 @@ typedef enum
 
 #define FI_INIT_STATE 0
 
+/*
+ * FI_SITE_DESC - identity of a deterministic fault-injection site. The site passes one static descriptor as the
+ * FI_TEST_ARG argument. The acknowledging handler counts the reaches, decides whether this reach fires
+ * (fault_injection_fire_at_occurrence: 0 = every reach, k > 0 = the k-th reach only) and, when it fires, logs
+ * "FAULT INJECTION ACK site=... code=... target_operation=... requested_action=... reach=... fired=..." as a
+ * notification in the server error log, so a test can prove that the fault fired and how often.
+ */
+typedef struct fi_site_desc FI_SITE_DESC;
+struct fi_site_desc
+{
+  FI_TEST_CODE code;		/* code the site is armed with */
+  const char *site;		/* function that hosts the site */
+  const char *target_operation;	/* operation the fault interrupts */
+  const char *requested_action;	/* what the site does when the handler fires */
+  volatile int reach_count;	/* times the armed site was reached */
+  volatile int fired_count;	/* times the handler told the site to act */
+};
+
 
 typedef int (*FI_HANDLER_FUNC) (THREAD_ENTRY * thread_p, void *arg, const char *caller_file, const int caller_line);
 
