 ch_reuse()
 {
     local phase=$1 state=$2 pages
     # The first cycle (or the aborted INSERT) sets the page ceiling of this
     # workload. A later identical workload must reuse its emptied pages, so
-    # its page count must not exceed the ceiling.
+    # its page count stays within the ceiling plus a small allowance: chunk
+    # placement and pages deferred under a latch can differ by a page or two
+    # between runs (OOS-CONTEXT ADR-0009). Exceeding the exact ceiling is an
+    # observation; exceeding the allowance is growth.
     pages=$(jq '.oos_num_user_pages' <<< "$state")
     if [ "$ch_learning" -eq 1 ]; then
         [ "$pages" -le "$ch_ceiling" ] || ch_ceiling=$pages
         sn_pass "${phase}_page_ceiling" "$(jq -n --argjson pages "$pages" --argjson ceiling "$ch_ceiling" '{pages:$pages,ceiling:$ceiling}')"
     else
-        ch_assert "${phase}_reuse_before_page_growth" '.pages<=.ceiling' "$(jq -n --argjson pages "$pages" --argjson ceiling "$ch_ceiling" '{pages:$pages,ceiling:$ceiling,idle_page_return_required:false}')"
+        ch_assert "${phase}_reuse_before_page_growth" '.pages<=.ceiling+.allowance' "$(jq -n --argjson pages "$pages" --argjson ceiling "$ch_ceiling" --argjson allowance "$(oos_page_allowance "$ch_ceiling")" '{pages:$pages,ceiling:$ceiling,allowance:$allowance,exact_ceiling_kept:($pages<=$ceiling),idle_page_return_required:false}')"
     fi
 }
