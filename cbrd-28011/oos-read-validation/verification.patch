  * The deallocation-tolerant fix first proves the page's sector is still reserved, which is what
  * keeps the debug page-validation level from failing the fetch of a page whose sector was released;
  * that probe costs two extra fixes of cached volume pages per call, on the read path too. */
+/* CBRD-28011 review validation only: CUBRID_OOS_SKIP_SECTOR_PROBE set in the process environment makes
+ * oos_fix_page_if_oos skip the sector-reservation probe and keep the rest of the deallocation-tolerant fix. */
+static bool
+oos_validation_skip_sector_probe ()
+{
+  static const bool skip = std::getenv ("CUBRID_OOS_SKIP_SECTOR_PROBE") != NULL;
+  return skip;
+}
+
 static int
 oos_fix_page_if_oos (THREAD_ENTRY *thread_p, const OID &oid, PGBUF_LATCH_MODE latch_mode, PAGE_PTR &page_out)
 {
   VPID vpid = {oid.pageid, oid.volid};
 
   page_out = NULL;
-  int error = pgbuf_fix_if_not_deallocated (thread_p, &vpid, latch_mode, PGBUF_UNCONDITIONAL_LATCH, &page_out);
+  int error = NO_ERROR;
+  if (oos_validation_skip_sector_probe ())
+    {
+      page_out = pgbuf_fix (thread_p, &vpid, OLD_PAGE_MAYBE_DEALLOCATED, latch_mode, PGBUF_UNCONDITIONAL_LATCH);
+      if (page_out == NULL && !log_is_in_crash_recovery_and_not_yet_completes_redo ())
+	{
+	  ASSERT_ERROR_AND_SET (error);
