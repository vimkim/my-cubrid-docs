# Copy this file outside the Git checkout, edit it for the stable PC, and set
# RUNTIME_CONFIG to the copy before invoking the scripts.

export RESULTS_ROOT=/absolute/path/to/cbrd-26382-results

# Full-build inputs.
export BUILD_IMAGE=docker.io/cubridci/cubridci:develop
export BUILD_JDK_HOME=/opt/jdk8
export BUILD_JOBS=16
export GRADLE_CACHE_ROOT=/absolute/path/to/cbrd-26382-gradle-cache

# Benchmark container and CPU topology. SERVER_CPUS accepts taskset list syntax.
export CONTAINER_NAME=cbrd26382-stable
export SERVER_CPUS=2,3
export CLIENT_CPU=4
# Optional QA-style run: allow migration within the stable PC's P-core set.
export P_CORE_CPUS=0-7
export MAX_RUNNABLE=24

# Container-internal layout. Change only if the stable container uses another layout.
export CONTAINER_BENCH_ROOT=/bench
export CONTAINER_INSTALL_ROOT=/opt
export DATABASE_NAME=c26382
export EXPECTED_RESULT=282475249
