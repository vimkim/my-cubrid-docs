+    }
+  catch (const std::bad_alloc &)
+    {
+      er_set (ER_ERROR_SEVERITY, ARG_FILE_LINE, ER_OUT_OF_VIRTUAL_MEMORY, 1, sizeof (heap_oos_column_plan));
+    }
+  if (status == S_SUCCESS)
+    {
+      record->set_type (REC_HOME);
+      pending->mark_prepared ();
+    }
+  return status;
