+
+// Real utility coverage: db_execute() alone does not exercise the standalone object loader.
+// Each GoogleTest case owns a fresh database and registry, including the no-logging case.
+#include "gtest/gtest.h"
+
+#include <cerrno>
+#include <cstdio>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <iterator>
+#include <map>
