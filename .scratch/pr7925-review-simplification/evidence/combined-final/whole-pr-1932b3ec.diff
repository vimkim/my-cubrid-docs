+       "UPDATE t_parts SET id=12 WHERE id=1; COMMIT;\n");
+  expect_chunks (sql ("SHOW HEAP OOS OF t_parts__p__p0;\n"), {0});
+  check ("t_parts__p__p1", "id IN (11,12) AND v=X'" + payload + "'", 2, 2);
+}
