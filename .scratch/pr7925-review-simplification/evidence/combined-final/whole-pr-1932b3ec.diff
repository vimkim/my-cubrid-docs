+    {
+      error = er_errid () == NO_ERROR ? ER_FAILED : er_errid ();
+    }
+  if (error == NO_ERROR)
+    {
+      MVCC_REC_HEADER header;
+      error = or_mvcc_get_header (source, &header);
+      if (error == NO_ERROR)
+        {
+          RECDES target = record->get_recdes ();
