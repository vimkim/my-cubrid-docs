+                         heap_pending_record *pending)
+{
+  record_descriptor *record = &pending->record ();
+  HEAP_CACHE_ATTRINFO attr_info;
+  int error = heap_attrinfo_start (thread_p, source_class, -1, nullptr, &attr_info);
+  if (error != NO_ERROR)
