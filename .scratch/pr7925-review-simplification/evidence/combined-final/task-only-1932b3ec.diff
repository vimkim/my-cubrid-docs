+TEST_F (OosWorkspaceTest, SuccessfulNoLoggingLoadStoresOos)
+{
+  sql ("CREATE TABLE t_nolog(v BIT VARYING); COMMIT;\n");
+  load ("%class t_nolog (v)\nX'" + payload + "'\n", {"--no-logging"});
+  check ("t_nolog", "v=X'" + payload + "'", 1, 1);
+}
