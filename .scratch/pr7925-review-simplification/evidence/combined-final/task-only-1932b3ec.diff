+#include "test_oos_sql_common.hpp"
+
+#include "heap_oos.hpp"
+#include "locator_cl.h"
+#include "log_impl.h"
+#include "object_domain.h"
+#include "object_primitive.h"
+#include "object_representation.h"
+#include "scope_exit.hpp"
