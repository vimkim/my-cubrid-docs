+    thread_p->oos_oids.clear ();
+    tdes->oos_insert_lsa_queue.clear ();
+    thread_p->oos_oids.push_back (root_oid);
+    tdes->oos_insert_lsa_queue.push (marker);
+    for (int input :
+	 {
+		 11, 21, 1, 21, 11
+	 })
