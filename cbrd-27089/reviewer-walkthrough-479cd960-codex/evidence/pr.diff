+  pr_clear_value (&prepared);
+  if (allocated != NULL)
+    {
+      db_private_free_and_init (thread_p, allocated);
+    }
+  if (error != NO_ERROR)
+    {
+      pr_clear_value (key);
+    }
+  return error;
+}
