+    }
+  if (error != NO_ERROR)
+    {
+      goto cleanup;
+    }
+  if (value->do_increment != 0)
+    {
+      error = qdata_increment_dbval (&prepared, &prepared, value->do_increment);
+      if (error != NO_ERROR)
+	{
