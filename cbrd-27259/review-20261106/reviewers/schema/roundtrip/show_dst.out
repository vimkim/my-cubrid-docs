  'dba.t1'              'CREATE TABLE [t1] ([a] CHARACTER VARYING(100) STORAGE FORCE_INLINE, [b] INTEGER, [c] INTEGER, [d] CHARACTER VARYING(1073741823) STORAGE PREFER_INLINE, [e] CHARACTER VARYING(1073741823) STORAGE FORCE_OUTLINE, [f] CHARACTER VARYING(1073741823), [g] CHARACTER VARYING(1073741823), [h] CHARACTER(10) STORAGE FORCE_INLINE, [i] BIT(80)) REUSE_OID, COLLATE utf8_bin'
  'dba.force_inline'    'CREATE TABLE [force_inline] ([force_inline] INTEGER, [force_inline2] CHARACTER VARYING(1073741823) STORAGE FORCE_INLINE) REUSE_OID, COLLATE utf8_bin'
  'dba.m'               'CREATE TABLE [m] CLASS ATTRIBUTE ([ca3] CHARACTER VARYING(1073741823)) ([id] INTEGER, [c4] CHARACTER VARYING(30) STORAGE FORCE_INLINE, [n1r] CHARACTER VARYING(1073741823) INVISIBLE STORAGE FORCE_INLINE DEFAULT 'y' NOT NULL, [n2] INTEGER, [n3] INTEGER) REUSE_OID, COLLATE utf8_bin'
  'dba.pt'              'CREATE TABLE [pt] ([id] INTEGER, [c] INTEGER, [d] CHARACTER VARYING(1073741823) STORAGE FORCE_INLINE) REUSE_OID, COLLATE utf8_bin PARTITION BY HASH ([id]) PARTITIONS 2'
  'dba.rp'              'CREATE TABLE [rp] ([id] INTEGER, [c] CHARACTER VARYING(1073741823) STORAGE FORCE_INLINE) REUSE_OID, COLLATE utf8_bin'
  'dba.sup'             'CREATE TABLE [sup] ([a] CHARACTER VARYING(1073741823) STORAGE FORCE_INLINE, [b] CHARACTER VARYING(1073741823) STORAGE FORCE_INLINE) REUSE_OID, COLLATE utf8_bin'
  'dba.sub'             'CREATE TABLE [sub] UNDER [dba.sup] ([x] INTEGER) REUSE_OID, COLLATE utf8_bin'
  'dba.lk'              'CREATE TABLE [lk] ([a] CHARACTER VARYING(100) STORAGE FORCE_INLINE, [b] INTEGER, [c] INTEGER, [d] CHARACTER VARYING(1073741823) STORAGE PREFER_INLINE, [e] CHARACTER VARYING(1073741823) STORAGE FORCE_OUTLINE, [f] CHARACTER VARYING(1073741823), [g] CHARACTER VARYING(1073741823), [h] CHARACTER(10) STORAGE FORCE_INLINE, [i] BIT(80)) REUSE_OID, COLLATE utf8_bin'
  'dba.ct1'             'CREATE TABLE [ct1] ([c] CHARACTER VARYING(1073741823) STORAGE FORCE_INLINE) REUSE_OID, COLLATE utf8_bin'
  'dba.ct2'             'CREATE TABLE [ct2] ([z] CHARACTER VARYING(1073741823) STORAGE FORCE_INLINE, [a] CHARACTER VARYING(100)) REUSE_OID, COLLATE utf8_bin'
  'dba.ct3'             'CREATE TABLE [ct3] ([a] CHARACTER VARYING(100), [b] INTEGER, [c] INTEGER, [d] CHARACTER VARYING(1073741823), [e] CHARACTER VARYING(1073741823), [f] CHARACTER VARYING(1073741823), [g] CHARACTER VARYING(1073741823), [h] CHARACTER(10), [i] BIT(80)) REUSE_OID, COLLATE utf8_bin'
  'dba.ct4'             'CREATE TABLE [ct4] ([z] INTEGER, [y] INTEGER) REUSE_OID, COLLATE utf8_bin'
  'dba.rp2'             'CREATE TABLE [rp2] ([id] INTEGER, [c] CHARACTER VARYING(500) STORAGE FORCE_INLINE, [d] CHARACTER VARYING(20) STORAGE FORCE_INLINE) REUSE_OID, COLLATE utf8_bin PARTITION BY RANGE ([id])  (PARTITION [p0] VALUES LESS THAN (10), PARTITION [p1a] VALUES LESS THAN (15), PARTITION [p1b] VALUES LESS THAN (20))'
     id                   INTEGER /* from dba.pt */
     c                    INTEGER /* from dba.pt */
     d                    CHARACTER VARYING(1073741823) STORAGE FORCE_INLINE /* from dba.pt */
     a                    CHARACTER VARYING(1073741823) STORAGE FORCE_INLINE /* from dba.sup */
     b                    CHARACTER VARYING(1073741823) STORAGE FORCE_INLINE /* from dba.sup */
     x                    INTEGER
     id                   INTEGER /* from dba.rp2 */
     c                    CHARACTER VARYING(500) STORAGE FORCE_INLINE /* from dba.rp2 */
     d                    CHARACTER VARYING(20) STORAGE FORCE_INLINE /* from dba.rp2 */
     id                   INTEGER
     c4                   CHARACTER VARYING(30) STORAGE FORCE_INLINE
     n1r                  CHARACTER VARYING(1073741823) INVISIBLE STORAGE FORCE_INLINE DEFAULT 'y' NOT NULL
     n2                   INTEGER
     n3                   INTEGER
     ca3                  CHARACTER VARYING(1073741823)
