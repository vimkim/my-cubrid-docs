# CBRD-27014 · PPT A (OOS 기술 리뷰) deliverables
#
# Edit pptA-oos-review.html / deck.css / deck.js, then run `just pptx`.
# Only pptA-oos-review.pptx is generated.

default:
    @just --list

# Regenerate the PPTX by screenshotting pptA-oos-review.html
pptx:
    bash export_pptx.sh

# Regenerate the simplified-deck PPTX from ppt-oos-simplified.html
pptx-simplified:
    bash export_pptx.sh ppt-oos-simplified.html ppt-oos-simplified.pptx

# Open the HTML deck in the default browser (arrow keys / click to navigate)
open:
    xdg-open pptA-oos-review.html
